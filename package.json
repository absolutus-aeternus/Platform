{
  "name": "alliancehub-platform",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 node_modules/.bin/vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --max-warnings 0 || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa": "bash scripts/qa-check.sh",
    "worker:dev": "wrangler dev src/worker/index.js --port 8788",
    "worker:deploy": "wrangler deploy src/worker/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@supabase/cli-linux-x64": "^1.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "supabase": "^2.115.0",
    "vite": "^4.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
